
{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "type": "object",
      "description": "Represents an administrative user for the RotaKula application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the admin user."
        },
        "username": {
          "type": "string",
          "description": "Username of the admin user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the admin user.",
          "format": "email"
        },
        "firstName": {
          "type": "string",
          "description": "First name of the admin user."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the admin user."
        }
      },
      "required": [
        "id",
        "username",
        "email"
      ]
    },
    "Survey": {
      "title": "Survey",
      "type": "object",
      "description": "Represents a survey response from a user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the survey response."
        },
        "poiId": {
          "type": "string",
          "description": "The ID of the Point of Interest the survey is for."
        },
        "poiName": {
          "type": "string",
          "description": "The name of the Point of Interest."
        },
        "guidance": {
          "type": "boolean",
          "description": "Whether the user received guidance service."
        },
        "staffing": {
          "type": "boolean",
          "description": "Whether a staff member attended to the user."
        },
        "cleanliness": {
          "type": "number",
          "description": "Rating for the cleanliness of the area (1-5)."
        },
        "transportation": {
          "type": "number",
          "description": "Rating for the ease of transportation (1-5)."
        },
        "overall": {
          "type": "number",
          "description": "Overall rating for the visit (1-5)."
        },
        "comment": {
          "type": "string",
          "description": "Additional comments from the user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the survey was submitted."
        }
      },
      "required": [
        "id",
        "poiId",
        "poiName",
        "guidance",
        "staffing",
        "cleanliness",
        "transportation",
        "overall",
        "createdAt"
      ]
    },
    "Reply": {
      "title": "Reply",
      "type": "object",
      "description": "Represents a reply to a feedback comment.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the user replying (optional)."
        },
        "message": {
          "type": "string",
          "description": "The reply message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the reply was submitted."
        }
      },
      "required": [
        "message",
        "createdAt"
      ]
    },
    "Feedback": {
      "title": "Feedback",
      "type": "object",
      "description": "Represents a feedback submission from a user about the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the feedback."
        },
        "name": {
          "type": "string",
          "description": "Name of the user providing feedback (optional)."
        },
        "message": {
          "type": "string",
          "description": "The feedback message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the feedback was submitted."
        },
        "likes": {
          "type": "number",
          "description": "The number of likes the feedback has received."
        },
        "replies": {
          "type": "array",
          "description": "A list of replies to this feedback.",
          "items": {
            "$ref": "#/entities/Reply"
          }
        }
      },
      "required": [
        "id",
        "message",
        "createdAt"
      ]
    },
    "PointOfInterest": {
      "title": "PointOfInterest",
      "type": "object",
      "description": "A site location that can override or extend the bundled POI catalog.",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "longDescription": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["geopark", "history", "food", "nature", "accommodation"]
        },
        "imageId": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "mapQuery": { "type": "string" },
        "name_en": { "type": "string" },
        "description_en": { "type": "string" },
        "longDescription_en": { "type": "string" },
        "name_fr": { "type": "string" },
        "description_fr": { "type": "string" },
        "longDescription_fr": { "type": "string" },
        "name_de": { "type": "string" },
        "description_de": { "type": "string" },
        "longDescription_de": { "type": "string" },
        "badgeId": { "type": "string" },
        "points": { "type": "number" },
        "hideStreetView": { "type": "boolean" },
        "deleted": { "type": "boolean" }
      },
      "required": [
        "id",
        "slug",
        "name",
        "description",
        "longDescription",
        "category",
        "imageId",
        "latitude",
        "longitude"
      ]
    },
    "BikeRoute": {
      "title": "BikeRoute",
      "type": "object",
      "description": "A cycling route, optionally linked to KML geometry and points of interest.",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "distance": { "type": "string" },
        "kmlPath": { "type": "string" },
        "poiIds": { "type": "array", "items": { "type": "string" } },
        "name_en": { "type": "string" },
        "description_en": { "type": "string" },
        "name_fr": { "type": "string" },
        "description_fr": { "type": "string" },
        "name_de": { "type": "string" },
        "description_de": { "type": "string" }
      },
      "required": ["id", "slug", "name", "description", "distance", "kmlPath"]
    },
    "WalkingRoute": {
      "title": "WalkingRoute",
      "type": "object",
      "description": "A walking route, optionally linked to KML geometry, points of interest, and trail statistics.",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "distance": { "type": "string" },
        "kmlPath": { "type": "string" },
        "poiIds": { "type": "array", "items": { "type": "string" } },
        "elevationGain": { "type": "string" },
        "elevationLoss": { "type": "string" },
        "maxElevation": { "type": "string" },
        "minElevation": { "type": "string" },
        "trailRank": { "type": "string" },
        "difficulty": { "type": "string" },
        "trackType": { "type": "string" },
        "name_en": { "type": "string" },
        "description_en": { "type": "string" },
        "name_fr": { "type": "string" },
        "description_fr": { "type": "string" },
        "name_de": { "type": "string" },
        "description_de": { "type": "string" }
      },
      "required": ["id", "slug", "name", "description", "distance", "kmlPath"]
    },
    "SiteStats": {
      "title": "SiteStats",
      "type": "object",
      "description": "Represents statistics for the website, like visitor counts.",
      "properties": {
        "count": {
          "type": "number",
          "description": "Total visitor count."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last update."
        }
      },
      "required": [
        "count",
        "lastUpdated"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "pois": {
      "schema": {
        "$ref": "#/entities/PointOfInterest"
      },
      "description": "Admin-managed POI overrides and additions. A deleted marker hides a bundled POI."
    },
    "walkingRoutes": {
      "schema": {
        "$ref": "#/entities/WalkingRoute"
      },
      "description": "Admin-managed walking route overrides and additions. A deleted marker hides a bundled route."
    },
    "bikeRoutes": {
      "schema": {
        "$ref": "#/entities/BikeRoute"
      },
      "description": "Admin-managed bike route overrides and additions. A deleted marker hides a bundled route."
    },
    "surveys": {
      "schema": {
        "$ref": "#/entities/Survey"
      },
      "description": "Collection to store user survey responses."
    },
    "feedback": {
      "schema": {
        "$ref": "#/entities/Feedback"
      },
      "description": "Collection to store user feedback about the application."
    },
    "stats/visitors": {
      "schema": {
        "$ref": "#/entities/SiteStats"
      },
      "description": "Document to store site visitor statistics."
    }
  }
}
