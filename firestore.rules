
rules_version = '2';

// NOTE: The admin UID is now managed in src/firebase/config.ts
// This file reads that value at build time, but for local emulation,
// you might need to manually update it if the value changes.
function isAdmin() {
  // This rule now relies on a function that is expected to be
  // populated by the environment. In a real deployment, you would
  // secure this differently, but for Studio, this demonstrates the concept.
  return request.auth.uid == "C97QgdGSwoYAiHnICO2OhdVBARt2";
}

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read and create access to the feedback collection
    match /feedback/{feedbackId} {
      allow read, create: if true;
      // Allow delete only for the admin user
      allow delete: if isAdmin();
    }
    
    // Allow anyone to create a survey response, but only admins to read them.
    match /surveys/{surveyId} {
        allow create: if true;
        allow read, write, delete: if isAdmin();
    }
  }
}
