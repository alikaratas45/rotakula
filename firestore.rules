
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      // Ensure the user is authenticated and their email matches the admin email.
      return request.auth != null && request.auth.token.email == "alikarataskula@gmail.com";
    }

    // Feedback Collection: Anyone can read and create. Admin can delete.
    match /feedback/{feedbackId} {
      allow read, create: if true;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Survey responses: Anyone can create a response. Admin can read, list, and delete.
    match /surveys/{surveyId} {
      allow create: if true;
      allow read, list, delete: if isAdmin();
      allow update: if false;
    }

    // Content for QR codes: Publicly readable, admin-only write access.
    match /content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Default-deny all other reads and writes for security.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
