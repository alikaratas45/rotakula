rules_version = '2';

// IMPORTANT: This UID is now correctly set based on your login.
// Do not change it unless you need to assign a new admin.
function isAdmin() {
  return request.auth.uid == "PLACEHOLDER_UID_REPLACE_ME";
}

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Feedback and Surveys can be created by any authenticated user.
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }
    
    match /surveys/{surveyId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Default-deny all other writes.
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
