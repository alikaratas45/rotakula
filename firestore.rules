
rules_version = '2';

// IMPORTANT: This UID is now correctly set based on your login.
// Do not change it unless you need to assign a new admin.
function isAdmin() {
  return request.auth.uid == "C97QgdGSwoYAiHnICO2OhdVBARt2";
}

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read and create access to the feedback collection
    match /feedback/{feedbackId} {
      allow read, create: if true;
      // Allow delete only for the admin user
      allow delete: if isAdmin();
    }
    
    // Allow anyone to create a survey response.
    // Allow anyone to read/list survey responses.
    // Only allow admin to write/delete.
    match /surveys/{surveyId} {
        allow create: if true;
        allow get, list: if true;
        allow write, delete: if isAdmin();
    }
  }
}
