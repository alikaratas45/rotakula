
rules_version = '2';

// NOTE: This file is automatically updated with the admin user's UID.
function isAdmin() {
  return request.auth.uid == 'UXt4xEAkIwUSAQXvaM4pngZCBtI3';
}

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read and create access to the feedback collection
    match /feedback/{feedbackId} {
      allow read, create: if true;
      // Allow delete only for the admin user
      allow delete: if isAdmin();
    }
    
    // Allow anyone to create a survey response, but only admins to read them.
    match /surveys/{surveyId} {
        allow create: if true;
        allow read, write, delete: if isAdmin();
    }
  }
}
