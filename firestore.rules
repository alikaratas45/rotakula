rules_version = '2';

// IMPORTANT: This UID is now correctly set based on your login.
// Do not change it unless you need to assign a new admin.
function isAdmin() {
  return request.auth.uid == "C97QgdGSwoYAiHnICO2OhdVBARt2";
}

service cloud.firestore {
  match /databases/{database}/documents {
    // GENEL OKUMA ve YAZMA KURALI: Herkesin tüm belgeleri okumasına, listelemesine ve oluşturmasına/güncellemesine izin ver.
    // Bu, hem okuma hem de yazma sırasındaki "izin reddedildi" hatalarını kesin olarak çözer.
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Yalnızca SİLME işlemleri yöneticiye özel olacaktır.
    match /feedback/{feedbackId} {
      allow delete: if isAdmin();
    }
    
    match /surveys/{surveyId} {
      allow delete: if isAdmin();
    }
  }
}
