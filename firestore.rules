
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "alikarataskula@gmail.com";
    }

    // Feedback Collection: Anyone can read and create. No one can update or delete.
    match /feedback/{feedbackId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Survey responses: Anyone can create a response. Only admin can read them.
    match /surveys/{surveyId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    
    // Default-deny all other reads and writes for security.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
