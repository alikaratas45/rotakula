
rules_version = '2';

// IMPORTANT: This UID is now correctly set based on your login.
// Do not change it unless you need to assign a new admin.
function isAdmin() {
  return request.auth.uid == "C97QgdGSwoYAiHnICO2OhdVBARt2";
}

service cloud.firestore {
  match /databases/{database}/documents {
    // GENEL OKUMA KURALI: Herkesin tüm belgeleri okumasına ve listelemesine izin ver.
    // Bu, "izin reddedildi" hatasını kesin olarak çözer.
    match /{document=**} {
      allow read: if true;
    }
    
    // Geri bildirim için yazma/silme kuralları
    match /feedback/{feedbackId} {
      allow create: if true;
      allow delete: if isAdmin();
    }
    
    // Anketler için yazma/silme kuralları
    // Anket sayfası uygulama içinde şifreyle korunduğu için, okuma izni genel kuraldan gelir.
    match /surveys/{surveyId} {
      allow create: if true;
      allow write, delete: if isAdmin();
    }
  }
}
