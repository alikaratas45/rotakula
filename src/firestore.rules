
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      // Ensure the user is authenticated and their email matches the admin email.
      return request.auth != null && request.auth.token.email == "alikarataskula@gmail.com";
    }

    match /feedback/{feedbackId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /surveys/{surveyId} {
      allow create: if true; // Anyone can submit a survey.
      allow read, list, delete: if isAdmin(); // Only admin can read, list, or delete surveys.
      allow update: if false; // No one can update a survey.
    }
    
    // Default-deny all other reads and writes for security.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
