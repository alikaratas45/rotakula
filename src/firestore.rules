
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Feedback Collection: Anyone can read and create. No one can update or delete.
    match /feedback/{document=**} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // POI Comments Collection: Allow anyone to list and read comments, and create new ones.
    match /poi_comments/{document=**} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    
    // Default-deny all other reads and writes for security.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
