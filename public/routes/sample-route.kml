<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Örnek Bisiklet Rotası</name>
    <description>Kula merkezinden başlayan ve Jeopark alanına uzanan örnek bir rota.</description>
    <Style id="yellowLineGreenPoly">
      <LineStyle>
        <color>7f00ffff</color>
        <width>4</width>
      </LineStyle>
      <PolyStyle>
        <color>7f00ff00</color>
      </PolyStyle>
    </Style>
    <Placemark>
      <name>Örnek Rota</name>
      <description>Kula Tarihi Çarşısı'ndan Kula Divlit Volkanik Parkı'na.</description>
      <styleUrl>#yellowLineGreenPoly</styleUrl>
      <LineString>
        <extrude>1</extrude>
        <tessellate>1</tessellate>
        <altitudeMode>absolute</altitudeMode>
        <coordinates>
          28.646944,38.546667,0
          28.650000,38.550000,0
          28.655000,38.555000,0
          28.661074,38.557861,0
          28.665000,38.565000,0
          28.669391,38.570672,0
        </coordinates>
      </LineString>
    </Placemark>
  </Document>
